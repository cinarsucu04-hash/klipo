# Yerelde denemek için kopyalayıp .env yapın ve değerleri doldurun.
# (Render'da bu değerleri panelden "Environment" bölümüne girin; dosyayı repoya koymayın.)
MONGO_URL=mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=klipo
SESSION_SECRET=en-az-32-karakterlik-rastgele-bir-metin
ADMIN_USERNAMES=admin
STORAGE=gridfs
MAX_VIDEO_MB=60

# Güvenlik (isteğe bağlı)
MAX_ACCOUNTS_PER_IP=3          # aynı ağdan açılabilecek hesap sayısı
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com   # "Google ile devam et" için (Google Cloud > OAuth istemci kimliği, Web)
# IP_SALT=rastgele-bir-metin    # IP özetleri için (boşsa SESSION_SECRET kullanılır)

# E-posta doğrulaması (biri yeterli; hiçbiri yoksa kayıt yalnızca captcha ile çalışır)
# MAIL_FROM=klipo.destek@gmail.com
# BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...
# GMAIL_CLIENT_ID=...  GMAIL_CLIENT_SECRET=...  GMAIL_REFRESH_TOKEN=...
# EMAIL_VERIFY=0                 # doğrulamayı bilerek kapatır
# ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com

# Dış depo (S3 uyumlu: Cloudflare R2, Backblaze B2...) — hepsi doluysa yeni yüklemeler MongoDB yerine buraya gider
# S3_ENDPOINT=https://HESAP.r2.cloudflarestorage.com
# S3_BUCKET=klipo
# S3_KEY_ID=...
# S3_SECRET=...
# S3_REGION=auto
# STORAGE_MIGRATE=copy+free      # panele girilemiyorsa açılışta taşır (copy = yalnızca kopyala); bitince sil
# DB_QUOTA_MB=512                # Atlas ücretsiz kota
# DB_GUARD_PCT=92                # bu doluluktan sonra yeni yükleme durur
